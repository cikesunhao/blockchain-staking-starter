# 部署后把 LockedStaking 合约地址填在这里（Sepolia 测试网）
VITE_STAKING_ADDRESS=0x0000000000000000000000000000000000000000
# 唯一的质押/奖励代币地址（锁仓版是单一代币模型）
VITE_STAKING_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# 自己的 RPC，例如 Alchemy / Infura 的 Sepolia 地址；没有也可以先用钱包默认节点
VITE_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
